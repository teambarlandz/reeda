// LibraryScreen.slint — library grid with empty-state onboarding.
// See docs/UI_UX.md §3.

import { Theme } from "./Theme.slint";
import { BookCard, BookInfo } from "./BookCard.slint";

export component LibraryScreen inherits Rectangle {
    callback import-requested();
    callback book-opened(string);
    callback edit-requested(string);
    callback settings-requested();
    callback search-requested();

    in property < bool > is-empty: true;
    in property < string > book-count-text: "0 books";
    in property < [BookInfo] > books;

    background: Theme.current.background;

    VerticalLayout {
        // Top bar
        Rectangle {
            height: 56px;
            background: Theme.current.surface;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                Text {
                    text: @tr("Reeda");
                    font-size: 20pt;
                    font-weight: 700;
                    color: Theme.current.foreground;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: root.book-count-text;
                        font-size: 14pt;
                        color: Theme.current.foreground;
                        opacity: 0.6;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        horizontal-stretch: 0;
                        background: Theme.current.surface_variant;
                        border-radius: 18px;

                        Text {
                            text: @tr("🔍");
                            font-size: 16pt;
                            color: Theme.current.foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            accessible-role: button;
                            accessible-label: @tr("Search");
                            clicked => { root.search-requested(); }
                        }
                    }

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        horizontal-stretch: 0;
                        background: Theme.current.surface_variant;
                        border-radius: 18px;

                        Text {
                            text: @tr("⚙");
                            font-size: 16pt;
                            color: Theme.current.foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            accessible-role: button;
                            accessible-label: @tr("Settings");
                            clicked => { root.settings-requested(); }
                        }
                    }
                }
            }
        }

        // Empty state
        if root.is-empty : VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding: 48px;
            spacing: 24px;

            Rectangle {
                height: 120px;
                horizontal-stretch: 0;

                Text {
                    text: @tr("R");
                    font-size: 64pt;
                    font-weight: 900;
                    color: Theme.current.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: @tr("Your library is empty");
                font-size: 20pt;
                font-weight: 600;
                color: Theme.current.foreground;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("Import EPUB or PDF books to get started.\nSupported formats: .epub, .pdf");
                font-size: 14pt;
                color: Theme.current.foreground;
                opacity: 0.6;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                background: Theme.current.accent;
                border-radius: 12px;
                height: 48px;
                horizontal-stretch: 0;

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: @tr("Import your first book");
                        color: white;
                        font-size: 16pt;
                        font-weight: 600;
                    }
                }

                touch := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("Import your first book");
                    clicked => { root.import-requested(); }
                }
            }
        }

        // Library grid (populated state).
        if !root.is-empty : Flickable {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;

                for book in root.books: BookCard {
                    book: book;
                    clicked(id) => { root.book-opened(id); }
                    edit-requested(id) => { root.edit-requested(id); }
                }
            }
        }

        // Bottom bar
        Rectangle {
            height: 48px;
            background: Theme.current.surface;
        }
    }
}
