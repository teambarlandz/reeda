// LibraryScreen.slint — library grid with empty-state onboarding.
// See docs/UI_UX.md §3.

import { Theme } from "./Theme.slint";
import { BookCard, BookInfo } from "./BookCard.slint";
import { BookContextMenu } from "./BookContextMenu.slint";

export component LibraryScreen inherits Rectangle {
    callback import-requested();
    callback book-opened(string);
    callback edit-requested(string);
    callback delete-requested(string, string);
    callback settings-requested();
    callback search-requested();

    in property < bool > is-empty: true;
    in property < string > book-count-text: "0 books";
    in property < [BookInfo] > books;

    // Per-cover context menu state (UI_UX-CONTEXT.md §3).
    in-out property < string > context-id: "";
    in-out property < string > context-title: "";
    in-out property < bool > context-open: false;

    background: Theme.current.background;

    VerticalLayout {
        // Top bar
        Rectangle {
            height: 56px;
            background: Theme.current.surface;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                Text {
                    text: @tr("Reeda");
                    font-size: 20pt;
                    font-weight: 700;
                    color: Theme.current.foreground;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: root.book-count-text;
                        font-size: 14pt;
                        color: Theme.current.foreground;
                        opacity: 0.6;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        horizontal-stretch: 0;
                        background: Theme.current.surface_variant;
                        border-radius: 18px;

                        Text {
                            text: @tr("🔍");
                            font-size: 16pt;
                            color: Theme.current.foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            accessible-role: button;
                            accessible-label: @tr("Search");
                            clicked => { root.search-requested(); }
                        }
                    }

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        horizontal-stretch: 0;
                        background: Theme.current.surface_variant;
                        border-radius: 18px;

                        Text {
                            text: @tr("⚙");
                            font-size: 16pt;
                            color: Theme.current.foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            accessible-role: button;
                            accessible-label: @tr("Settings");
                            clicked => { root.settings-requested(); }
                        }
                    }
                }
            }
        }

        // Empty state
        if root.is-empty : VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding: 48px;
            spacing: 24px;

            Rectangle {
                height: 120px;
                horizontal-stretch: 0;

                Text {
                    text: @tr("R");
                    font-size: 64pt;
                    font-weight: 900;
                    color: Theme.current.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: @tr("Your library is empty");
                font-size: 20pt;
                font-weight: 600;
                color: Theme.current.foreground;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("Import EPUB or PDF books to get started.\nSupported formats: .epub, .pdf");
                font-size: 14pt;
                color: Theme.current.foreground;
                opacity: 0.6;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                background: Theme.current.accent;
                border-radius: 12px;
                height: 48px;
                horizontal-stretch: 0;

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: @tr("Import your first book");
                        color: white;
                        font-size: 16pt;
                        font-weight: 600;
                    }
                }

                touch := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("Import your first book");
                    clicked => { root.import-requested(); }
                }
            }
        }

        // Library grid (populated state).
        if !root.is-empty : Flickable {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;

                for book in root.books: BookCard {
                    book: book;
                    clicked(id) => { root.book-opened(id); }
                    menu-requested(id, title) => {
                        root.context-id = id;
                        root.context-title = title;
                        root.context-open = true;
                    }
                }
            }
        }

        // Bottom bar
        Rectangle {
            height: 48px;
            background: Theme.current.surface;
        }
    }

    // Import FAB (UI_UX.md §3): bottom-right, always reachable so new
    // books can be added regardless of library state.
    fab := Rectangle {
        width: 56px;
        height: 56px;
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 72px;
        border-radius: 28px;
        background: Theme.current.accent;

        Text {
            text: @tr("+");
            color: white;
            font-size: 28pt;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            accessible-role: button;
            accessible-label: @tr("Import book");
            clicked => { root.import-requested(); }
        }
    }

    // Per-cover context menu (UI_UX-CONTEXT.md §3): popover on desktop,
    // bottom sheet below 600px. Declared last → topmost overlay.
    if root.context-open : BookContextMenu {
        book-title: root.context-title;
        sheet: root.width < 600px;

        open-book => {
            root.context-open = false;
            root.book-opened(root.context-id);
        }

        edit-metadata => {
            root.context-open = false;
            root.edit-requested(root.context-id);
        }

        delete-requested => {
            root.context-open = false;
            root.delete-requested(root.context-id, root.context-title);
        }

        dismissed => { root.context-open = false; }
    }
}
