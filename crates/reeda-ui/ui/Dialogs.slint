// Dialogs.slint — confirm, error, and progress dialog components.

import { Theme } from "./Theme.slint";

export component ErrorDialog inherits Rectangle {
    in property < string > message;
    in-out property < bool > open: false;

    visible: self.open;
    background: #00000088;
    width: 100%;
    height: 100%;

    Rectangle {
        background: Theme.current.surface;
        border-radius: 12px;
        width: 320px;
        height: content.preferred-height + 80px;
        horizontal-stretch: 0;
        vertical-stretch: 0;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            content := Text {
                text: root.message;
                wrap: word-wrap;
                color: Theme.current.foreground;
                font-size: 14pt;
            }

            HorizontalLayout {
                alignment: end;

                Rectangle {
                    background: Theme.current.accent;
                    border-radius: 8px;
                    width: 80px;
                    height: 36px;
                    horizontal-stretch: 0;

                    Text {
                        text: "OK";
                        color: white;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.open = false; }
                    }
                }
            }
        }
    }
}
