// Dialogs.slint — confirm, error, and progress dialog components.

import { Theme } from "./Theme.slint";

export component ErrorDialog inherits Rectangle {
    in property < string > message;
    in-out property < bool > open: false;

    visible: self.open;
    background: #00000088;
    width: 100%;
    height: 100%;

    Rectangle {
        background: Theme.current.surface;
        border-radius: 12px;
        width: 320px;
        height: content.preferred-height + 80px;
        horizontal-stretch: 0;
        vertical-stretch: 0;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            content := Text {
                text: root.message;
                wrap: word-wrap;
                color: Theme.current.foreground;
                font-size: 14pt;
            }

            HorizontalLayout {
                alignment: end;

                Rectangle {
                    background: Theme.current.accent;
                    border-radius: 8px;
                    width: 80px;
                    height: 36px;
                    horizontal-stretch: 0;

                    Text {
                        text: "OK";
                        color: white;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        accessible-role: button;
                        accessible-label: "OK";
                        clicked => { root.open = false; }
                    }
                }
            }
        }
    }
}

export component NoteDialog inherits Rectangle {
    in-out property < bool > open: false;
    in-out property < string > note-text: "";
    callback save(string);
    callback cancel();

    visible: self.open;
    background: #00000088;
    width: 100%;
    height: 100%;

    Rectangle {
        background: Theme.current.surface;
        border-radius: 12px;
        width: 320px;
        horizontal-stretch: 0;
        vertical-stretch: 0;

        VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Text {
                text: "Add note";
                font-size: 18pt;
                font-weight: 700;
                color: Theme.current.foreground;
            }

            note-input := TextInput {
                text: root.note-text;
                font-size: 14pt;
                color: Theme.current.foreground;
                height: 40px;
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    background: Theme.current.surface_variant;
                    border-radius: 8px;
                    width: 80px;
                    height: 36px;
                    horizontal-stretch: 0;

                    Text {
                        text: "Cancel";
                        color: Theme.current.foreground;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Cancel";
                        clicked => { root.cancel(); }
                    }
                }

                Rectangle {
                    background: Theme.current.accent;
                    border-radius: 8px;
                    width: 80px;
                    height: 36px;
                    horizontal-stretch: 0;

                    Text {
                        text: "Save";
                        color: white;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Save";
                        clicked => { root.save(note-input.text); }
                    }
                }
            }
        }
    }
}

export component MetadataDialog inherits Rectangle {
    in-out property < bool > open: false;
    in-out property < string > book-title: "";
    in-out property < string > book-author: "";
    callback save(string, string);
    callback cancel();

    visible: self.open;
    background: #00000088;
    width: 100%;
    height: 100%;

    Rectangle {
        background: Theme.current.surface;
        border-radius: 12px;
        width: 320px;
        horizontal-stretch: 0;
        vertical-stretch: 0;

        VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Text {
                text: "Edit book";
                font-size: 18pt;
                font-weight: 700;
                color: Theme.current.foreground;
            }

            Text {
                text: "Title";
                font-size: 12pt;
                color: Theme.current.foreground;
                opacity: 0.7;
            }

            title-input := TextInput {
                text: root.book-title;
                font-size: 14pt;
                color: Theme.current.foreground;
                height: 40px;
                horizontal-stretch: 1;
            }

            Text {
                text: "Author";
                font-size: 12pt;
                color: Theme.current.foreground;
                opacity: 0.7;
            }

            author-input := TextInput {
                text: root.book-author;
                font-size: 14pt;
                color: Theme.current.foreground;
                height: 40px;
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    background: Theme.current.surface_variant;
                    border-radius: 8px;
                    width: 80px;
                    height: 36px;
                    horizontal-stretch: 0;

                    Text {
                        text: "Cancel";
                        color: Theme.current.foreground;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Cancel";
                        clicked => { root.cancel(); }
                    }
                }

                Rectangle {
                    background: Theme.current.accent;
                    border-radius: 8px;
                    width: 80px;
                    height: 36px;
                    horizontal-stretch: 0;

                    Text {
                        text: "Save";
                        color: white;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Save";
                        clicked => {
                            root.save(title-input.text, author-input.text);
                        }
                    }
                }
            }
        }
    }
}
