// AppRoot.slint — root component with theme provider + screen stack.

export { Theme } from "./Theme.slint";
import { Theme } from "./Theme.slint";
import { BookInfo } from "./BookCard.slint";
import { LibraryScreen } from "./LibraryScreen.slint";
import { ReaderScreen, LineRun, OutlineItem } from "./ReaderScreen.slint";
import { NotesScreen, NotesEntry } from "./NotesScreen.slint";
import { BookmarksScreen, BookmarkEntry } from "./BookmarksScreen.slint";
import { SettingsScreen } from "./SettingsScreen.slint";
import { ErrorDialog, MetadataDialog, NoteDialog } from "./Dialogs.slint";
import { SearchScreen, SearchHit } from "./SearchScreen.slint";

export component AppRoot inherits Window {
    title: @tr("Reeda");
    preferred-width: 400px;
    preferred-height: 700px;

    // ── Screen visibility ───────────────────────────────────────────
    in-out property < bool > show-library: true;
    in-out property < bool > show-reader: false;
    in-out property < bool > show-settings: false;
    in-out property < bool > show-notes: false;
    in-out property < bool > show-bookmarks: false;
    in-out property < bool > show-search: false;

    // ── Search ──────────────────────────────────────────────────────
    in-out property < [SearchHit] > search-hits: [];
    in-out property < string > search-query: "";
    in-out property < bool > search-has-query: false;

    // ── In-reader search ────────────────────────────────────────────
    in-out property < bool > reader-search-open: false;
    in-out property < string > reader-search-query: "";
    in-out property < string > reader-search-count: "";

    // ── Narration (TTS bar) ─────────────────────────────────────────
    in-out property < bool > narration-active: false;
    in-out property < bool > narration-paused: false;
    in-out property < string > narration-speed-text: "1.0x";

    // ── Notes list ──────────────────────────────────────────────────
    in-out property < [NotesEntry] > notes-entries: [];
    in-out property < bool > note-dialog-open: false;
    in-out property < string > note-dialog-text: "";

    // ── Bookmarks ───────────────────────────────────────────────────
    in-out property < [BookmarkEntry] > bookmark-entries: [];
    in-out property < bool > reader-bookmarked: false;

    // ── Error dialog ────────────────────────────────────────────────
    in-out property < string > error-message: "";
    in-out property < bool > error-open: false;

    // ── Library properties ──────────────────────────────────────────
    in-out property < bool > library-is-empty: true;
    in-out property < string > library-count-text: "0 books";
    in-out property < [BookInfo] > library-books: [];

    // ── Metadata dialog ─────────────────────────────────────────────
    in-out property < bool > metadata-open: false;
    in-out property < string > metadata-title: "";
    in-out property < string > metadata-author: "";
    in-out property < string > metadata-book-id: "";

    // ── Settings ────────────────────────────────────────────────────
    in-out property < int > settings-theme-index: 0;
    in-out property < int > settings-font-size: 18;
    in-out property < int > settings-line-height: 15;

    // ── Reader properties (bound from Rust) ─────────────────────────
    in-out property < string > book-title: "";
    in-out property < string > page-text: "";
    in-out property < bool > chrome-visible: false;
    in-out property < float > progress-pct: 0.0;
    in-out property < string > progress-label: "0%";
    in-out property < [[LineRun]] > reader-page-lines: [];
    in-out property < length > reader-page-font-size: 18pt;
    in-out property < float > reader-page-line-height: 1.5;
    in-out property < bool > reader-edit-popover-visible: false;

    // ── PDF reader properties (M6.4, PDF_SPEC §4) ───────────────────
    in-out property < bool > pdf-mode: false;
    in-out property < int > pdf-page-count: 0;
    in-out property < [image] > pdf-images: [];
    in-out property < [length] > pdf-page-heights: [];
    in-out property < length > pdf-page-width: 0px;
    in-out property < length > pdf-content-height: 0px;
    in-out property < string > pdf-page-label: "";
    in-out property < string > pdf-zoom-text: "";
    in-out property < length > pdf-scroll-offset: 0px;
    in-out property < length > pdf-scroll-target: 0px;
    in-out property < [OutlineItem] > pdf-outline: [];

    // ── Reader callbacks ────────────────────────────────────────────
    callback next-page();
    callback prev-page();
    callback back-pressed();
    callback toggle-chrome();
    callback highlight-tapped(string);
    callback edit-color(int);
    callback delete-highlight();
    callback note-requested();
    callback close-popover();
    callback notes-back();
    callback notes-jump(string);
    callback notes-requested();
    callback notes-export();
    callback note-saved(string);
    callback note-cancelled();
    callback bookmarks-requested();
    callback bookmarks-back();
    callback bookmarks-jump(string);
    callback bookmark-delete(string);
    callback toggle-bookmark();
    callback import-requested();
    callback metadata-requested(string);
    callback metadata-saved(string, string);
    callback metadata-cancelled();
    callback settings-back();
    callback theme-selected(int);
    callback font-size-changed(int);
    callback line-height-changed(int);
    callback search-requested();
    callback search-back();
    callback search-query-changed(string);
    callback search-hit-opened(string, string, int, int, int);
    callback reader-search-toggled();
    callback reader-search-query-changed(string);
    callback reader-search-next();
    callback reader-search-prev();
    callback reader-search-close();
    callback narration-play-pause();
    callback narration-stop();
    callback narration-skip-back();
    callback narration-skip-forward();
    callback narration-speed-cycle();
    callback pdf-scrolled();
    callback pdf-visible-changed(float, float);
    callback pdf-zoom-by(float);
    callback pdf-toggle-zoom();
    callback pdf-jumped(string);
    callback pdf-outline-jumped(int);

    if root.show-library : LibraryScreen {
        is-empty: root.library-is-empty;
        book-count-text: root.library-count-text;
        books: root.library-books;

        import-requested => { root.import-requested(); }

        book-opened(id) => {
            root.show-library = false;
            root.show-reader = true;
        }

        edit-requested(id) => {
            root.metadata-book-id = id;
            root.metadata-requested(id);
        }

        settings-requested => {
            root.show-library = false;
            root.show-settings = true;
        }

        search-requested => {
            root.show-library = false;
            root.show-search = true;
            root.search-requested();
        }
    }

    if root.show-reader : ReaderScreen {
        book-title: root.book-title;
        page-text: root.page-text;
        chrome-visible: root.chrome-visible;
        progress-pct: root.progress-pct;
        progress-label: root.progress-label;
        page-lines: root.reader-page-lines;
        page-font-size: root.reader-page-font-size;
        page-line-height: root.reader-page-line-height;
        edit-popover-visible: root.reader-edit-popover-visible;
        bookmarked: root.reader-bookmarked;
        search-open: root.reader-search-open;
        search-query: root.reader-search-query;
        search-count: root.reader-search-count;
        narration-active: root.narration-active;
        narration-paused: root.narration-paused;
        narration-speed-text: root.narration-speed-text;
        pdf-mode: root.pdf-mode;
        pdf-page-count: root.pdf-page-count;
        pdf-images: root.pdf-images;
        pdf-page-heights: root.pdf-page-heights;
        pdf-page-width: root.pdf-page-width;
        pdf-content-height: root.pdf-content-height;
        pdf-page-label: root.pdf-page-label;
        pdf-zoom-text: root.pdf-zoom-text;
        pdf-scroll-offset: root.pdf-scroll-offset;
        pdf-scroll-target: root.pdf-scroll-target;
        pdf-outline: root.pdf-outline;

        back-pressed => {
            root.show-reader = false;
            root.show-library = true;
            root.back-pressed();
        }

        next-page => { root.next-page(); }
        prev-page => { root.prev-page(); }
        toggle-chrome => { root.chrome-visible = !root.chrome-visible; }
        highlight-tapped(id) => { root.highlight-tapped(id); }
        edit-color(i) => { root.edit-color(i); }
        delete-highlight => { root.delete-highlight(); }
        note-requested => { root.note-requested(); }
        notes-requested => {
            root.show-reader = false;
            root.show-notes = true;
            root.notes-requested();
        }
        bookmarks-requested => {
            root.show-reader = false;
            root.show-bookmarks = true;
            root.bookmarks-requested();
        }
        toggle-bookmark => { root.toggle-bookmark(); }
        close-popover => { root.reader-edit-popover-visible = false; }

        search-toggled => {
            root.reader-search-open = !root.reader-search-open;
            if !root.reader-search-open {
                root.reader-search-query = "";
                root.reader-search-count = "";
                root.reader-search-close();
            } else {
                root.reader-search-toggled();
            }
        }

        search-query-changed(t) => {
            root.reader-search-query = t;
            root.reader-search-query-changed(t);
        }

        search-next => { root.reader-search-next(); }
        search-prev => { root.reader-search-prev(); }

        search-close => {
            root.reader-search-open = false;
            root.reader-search-query = "";
            root.reader-search-count = "";
            root.reader-search-close();
        }

        narration-play-pause => { root.narration-play-pause(); }
        narration-stop => { root.narration-stop(); }
        narration-skip-back => { root.narration-skip-back(); }
        narration-skip-forward => { root.narration-skip-forward(); }
        narration-speed-cycle => { root.narration-speed-cycle(); }

        pdf-scrolled => { root.pdf-scrolled(); }
        pdf-visible-changed(w, h) => { root.pdf-visible-changed(w, h); }
        pdf-zoom-by(d) => { root.pdf-zoom-by(d); }
        pdf-toggle-zoom => { root.pdf-toggle-zoom(); }
        pdf-jumped(p) => { root.pdf-jumped(p); }
        pdf-outline-jumped(p) => { root.pdf-outline-jumped(p); }
    }

    if root.show-notes : NotesScreen {
        book-title: root.book-title;
        entries: root.notes-entries;

        back-pressed => {
            root.show-notes = false;
            root.show-reader = true;
            root.notes-back();
        }

        jump-to(id) => {
            root.show-notes = false;
            root.show-reader = true;
            root.notes-jump(id);
        }

        export => { root.notes-export(); }
    }

    if root.show-bookmarks : BookmarksScreen {
        book-title: root.book-title;
        entries: root.bookmark-entries;

        back-pressed => {
            root.show-bookmarks = false;
            root.show-reader = true;
            root.bookmarks-back();
        }

        jump-to(id) => {
            root.show-bookmarks = false;
            root.show-reader = true;
            root.bookmarks-jump(id);
        }

        delete(id) => { root.bookmark-delete(id); }
    }

    if root.show-settings : SettingsScreen {
        theme-index: root.settings-theme-index;
        font-size: root.settings-font-size;
        line-height: root.settings-line-height;

        back-pressed => {
            root.show-settings = false;
            root.show-library = true;
            root.settings-back();
        }

        theme-selected(i) => { root.theme-selected(i); }
        font-size-changed(d) => { root.font-size-changed(d); }
        line-height-changed(d) => { root.line-height-changed(d); }
    }

    if root.show-search : SearchScreen {
        query: root.search-query;
        has-query: root.search-has-query;
        hits: root.search-hits;

        back-pressed => {
            root.show-search = false;
            root.show-library = true;
            root.search-back();
        }

        query-changed(t) => {
            root.search-query = t;
            root.search-has-query = t != "";
            root.search-query-changed(t);
        }

        hit-opened(id, cfi, block, offset, len) => {
            root.show-search = false;
            root.search-hit-opened(id, cfi, block, offset, len);
        }
    }

    ErrorDialog {
        message: root.error-message;
        open: root.error-open;
    }

    MetadataDialog {
        open: root.metadata-open;
        book-title: root.metadata-title;
        book-author: root.metadata-author;

        save(title, author) => {
            root.metadata-open = false;
            root.metadata-saved(title, author);
        }

        cancel => {
            root.metadata-open = false;
            root.metadata-cancelled();
        }
    }

    NoteDialog {
        open: root.note-dialog-open;
        note-text: root.note-dialog-text;

        save(text) => {
            root.note-dialog-open = false;
            root.note-saved(text);
        }

        cancel => {
            root.note-dialog-open = false;
            root.note-cancelled();
        }
    }
}
