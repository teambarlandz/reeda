// ReaderScreen.slint — EPUB reader page canvas with chrome overlays.
// See docs/UI_UX.md §4 and docs/HIGHLIGHTS_SPEC.md §3.

import { Theme } from "./Theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct LineRun {
    text: string,
    highlighted: bool,
    color-index: int,
    has-note: bool,
    annotation-id: string,
}

export struct OutlineItem {
    title: string,
    page: int,
    depth: int,
}

export component ReaderScreen inherits Rectangle {
    callback back-pressed();
    callback toggle-chrome();
    callback next-page();
    callback prev-page();
    callback highlight-tapped(string);
    callback edit-color(int);
    callback delete-highlight();
    callback note-requested();
    callback notes-requested();
    callback bookmarks-requested();
    callback toggle-bookmark();
    callback close-popover();
    callback search-toggled();
    callback search-query-changed(string);
    callback search-next();
    callback search-prev();
    callback search-close();
    callback narration-play-pause();
    callback narration-stop();
    callback narration-skip-back();
    callback narration-skip-forward();
    callback narration-speed-cycle();

    // ── PDF mode (M6.4, PDF_SPEC §4) ─────────────────────────────────
    callback pdf-scrolled();
    callback pdf-visible-changed(float, float);
    callback pdf-zoom-by(float);
    callback pdf-toggle-zoom();
    callback pdf-jumped(string);
    callback pdf-outline-jumped(int);

    in property < bool > pdf-mode: false;
    in property < int > pdf-page-count: 0;
    in property < [image] > pdf-images: [];
    in property < [length] > pdf-page-heights: [];
    in property < length > pdf-page-width: 0px;
    in property < length > pdf-content-height: 0px;
    in property < string > pdf-page-label: "";
    in property < string > pdf-zoom-text: "";
    in-out property < length > pdf-scroll-offset: 0px;
    in property < length > pdf-scroll-target: 0px;
    in property < [OutlineItem] > pdf-outline: [];

    // Outline panel visibility (M6.5).
    property < bool > outline-open: false;

    in property < bool > chrome-visible: false;
    in property < string > book-title: "";
    in property < bool > bookmarked: false;
    in property < string > page-text: "";
    in property < float > progress-pct: 0.0;
    in property < string > progress-label: "0%";
    in property < [[LineRun]] > page-lines: [];
    in property < length > page-font-size: 18pt;
    in property < float > page-line-height: 1.5;
    in property < bool > edit-popover-visible: false;
    in property < bool > search-open: false;
    in property < string > search-query: "";
    in property < string > search-count: "";
    in property < bool > narration-active: false;
    in property < bool > narration-paused: false;
    in property < string > narration-speed-text: "1.0x";

    background: Theme.current.background;

    VerticalLayout {
        // Top chrome (auto-hide).
        if root.chrome-visible : Rectangle {
            height: 56px;
            background: Theme.current.surface;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 16px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;

                    Text {
                        text: "<";
                        font-size: 20pt;
                        color: Theme.current.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.back-pressed(); }
                    }
                }

                Text {
                    text: root.book-title;
                    font-size: 16pt;
                    font-weight: 600;
                    color: Theme.current.foreground;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 40px;
                    height: 40px;

                    Text {
                        text: "🔍";
                        font-size: 16pt;
                        color: root.search-open ? Theme.current.accent : Theme.current.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.search-toggled(); }
                    }
                }

                if root.pdf-mode : Rectangle {
                    width: 40px;
                    height: 40px;

                    Text {
                        text: "≡";
                        font-size: 18pt;
                        color: root.outline-open ? Theme.current.accent : Theme.current.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.outline-open = !root.outline-open; }
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 40px;

                    Text {
                        text: root.bookmarked ? "🔖" : "☰";
                        font-size: 18pt;
                        color: root.bookmarked ? Theme.current.accent : Theme.current.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.toggle-bookmark(); }
                    }
                }
            }
        }

        // In-reader search overlay.
        if root.search-open : Rectangle {
            background: Theme.current.surface;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                Rectangle {
                    width: 36px;
                    height: 40px;

                    Text {
                        text: "<";
                        font-size: 18pt;
                        color: Theme.current.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.search-close(); }
                    }
                }

                Rectangle {
                    background: Theme.current.surface_variant;
                    border-radius: 8px;
                    horizontal-stretch: 1;

                    TextInput {
                        text: root.search-query;
                        font-size: 13pt;
                        color: Theme.current.foreground;
                        horizontal-alignment: left;
                        vertical-alignment: center;

                        edited => { root.search-query-changed(self.text); }
                    }
                }

                Text {
                    text: root.search-count;
                    font-size: 12pt;
                    color: Theme.current.foreground;
                    opacity: 0.8;
                    vertical-alignment: center;
                    min-width: 44px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    width: 36px;
                    height: 40px;

                    Text {
                        text: "▲";
                        font-size: 14pt;
                        color: Theme.current.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.search-prev(); }
                    }
                }

                Rectangle {
                    width: 36px;
                    height: 40px;

                    Text {
                        text: "▼";
                        font-size: 14pt;
                        color: Theme.current.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.search-next(); }
                    }
                }
            }
        }

        // PDF canvas (M6.4): continuous vertical scroll of page images.
        if root.pdf-mode : Rectangle {
            property < bool > pdf-open: false;
            // Mirrors root.pdf-scroll-target so we can react to jumps (Rust
            // sets the target, this local binding updates → -changed fires).
            property < length > jump-target: root.pdf-scroll-target;
            horizontal-stretch: 1;
            background: Theme.current.background;

            sv := ScrollView {
                viewport-width: max(root.pdf-page-width, sv.visible-width);
                viewport-height: root.pdf-content-height;

                scrolled => {
                    root.pdf-scroll-offset = -sv.viewport-y;
                    root.pdf-scrolled();
                }

                Rectangle {
                    x: (sv.visible-width - root.pdf-page-width) / 2;
                    y: 8px;
                    width: root.pdf-page-width;
                    height: root.pdf-content-height;

                    VerticalLayout {
                        spacing: 8px;

                        for i in root.pdf-page-count : Rectangle {
                            width: parent.width;
                            height: root.pdf-page-heights[i];
                            background: Theme.current.surface;
                            border-radius: 2px;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.pdf-images[i];
                                image-fit: fill;
                            }
                        }
                    }

                    // Single-tap toggles chrome; double-tap toggles zoom.
                    TouchArea {
                        clicked => { root.toggle-chrome(); }
                        double-clicked => { root.pdf-toggle-zoom(); }
                    }
                }
            }

            // Sync the reported scroll offset when Rust jumps the viewport.
            changed jump-target => {
                sv.viewport-y = -root.pdf-scroll-target;
            }

            // Report viewport size changes (first layout + resizes).
            property < length > pdf-vw: sv.visible-width;
            property < length > pdf-vh: sv.visible-height;
            changed pdf-vw => {
                root.pdf-visible-changed(pdf-vw / 1px, pdf-vh / 1px);
            }

            // Page indicator + zoom controls (auto-hide with chrome).
            if root.chrome-visible : Rectangle {
                x: (parent.width - 220px) / 2;
                y: parent.height - 46px;
                width: 220px;
                height: 38px;
                border-radius: 19px;
                background: Theme.current.surface;
                border-width: 1px;
                border-color: Theme.current.surface_variant;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: "−";
                        font-size: 16pt;
                        color: Theme.current.foreground;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { root.pdf-zoom-by(-0.25); }
                        }
                    }

                    Text {
                        text: root.pdf-zoom-text;
                        font-size: 11pt;
                        font-weight: 600;
                        color: Theme.current.accent;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { root.pdf-toggle-zoom(); }
                        }
                    }

                    Text {
                        text: "+";
                        font-size: 16pt;
                        color: Theme.current.foreground;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { root.pdf-zoom-by(0.25); }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: Theme.current.surface_variant;
                    }

                    Text {
                        text: root.pdf-page-label;
                        font-size: 11pt;
                        color: Theme.current.foreground;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { pdf-open = true; }
                        }
                    }
                }
            }

            // Jump-to-page dialog.
            if pdf-open : Rectangle {
                x: (parent.width - 260px) / 2;
                y: 56px;
                width: 260px;
                height: 52px;
                border-radius: 10px;
                background: Theme.current.surface;
                border-width: 1px;
                border-color: Theme.current.surface_variant;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "Go to page";
                        font-size: 11pt;
                        color: Theme.current.foreground;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 64px;
                        height: 30px;
                        background: Theme.current.surface_variant;
                        border-radius: 6px;

                        jump-input := TextInput {
                            width: 64px;
                            height: 30px;
                            font-size: 12pt;
                            color: Theme.current.foreground;
                            horizontal-alignment: center;
                            input-type: number;

                            accepted => {
                                pdf-open = false;
                                root.pdf-jumped(self.text);
                            }
                        }
                    }

                    Text {
                        text: "Go";
                        font-size: 11pt;
                        font-weight: 600;
                        color: Theme.current.accent;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => {
                                pdf-open = false;
                                root.pdf-jumped(jump-input.text);
                            }
                        }
                    }
                }
            }
        }

        // Page text area (EPUB mode).
        if !root.pdf-mode : Rectangle {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 0px;

                for line in root.page-lines : HorizontalLayout {
                    height: root.page-font-size * root.page-line-height;
                    spacing: 0px;

                    for run in line : Rectangle {
                        if run.highlighted : Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            background: run.color-index == 0 ? Theme.current.highlight-yellow
                                : run.color-index == 1 ? Theme.current.highlight-green
                                : run.color-index == 2 ? Theme.current.highlight-blue
                                : run.color-index == 3 ? Theme.current.highlight-pink
                                : Theme.current.highlight-cyan;
                            opacity: 0.4;
                        }

                        VerticalLayout {
                            spacing: 0px;

                            Text {
                                text: run.text;
                                color: Theme.current.foreground;
                                font-size: root.page-font-size;
                                wrap: no-wrap;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                            }
                        }

                        if run.highlighted : Rectangle {
                            x: 0;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: run.color-index == 0 ? Theme.current.highlight-yellow
                                : run.color-index == 1 ? Theme.current.highlight-green
                                : run.color-index == 2 ? Theme.current.highlight-blue
                                : run.color-index == 3 ? Theme.current.highlight-pink
                                : Theme.current.highlight-cyan;
                        }

                        if run.has-note : Rectangle {
                            x: parent.width - 8px;
                            y: parent.height - 8px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.current.accent;
                        }

                        if run.highlighted : TouchArea {
                            clicked => { root.highlight-tapped(run.annotation-id); }
                        }
                    }
                }

                // Legacy fallback when no lines are computed.
                if root.page-lines.length == 0 : Text {
                    text: root.page-text;
                    color: Theme.current.foreground;
                    font-size: root.page-font-size;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
            }

            TouchArea {
                clicked => {
                    if (self.pressed-x < self.width * 0.25) {
                        root.prev-page();
                    } else if (self.pressed-x > self.width * 0.75) {
                        root.next-page();
                    } else {
                        root.toggle-chrome();
                    }
                }
            }
        }

        // Bottom chrome (auto-hide).
        if root.chrome-visible : Rectangle {
            height: 48px;
            background: Theme.current.surface;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                Text {
                    text: root.progress-label;
                    font-size: 12pt;
                    color: Theme.current.foreground;
                    opacity: 0.7;
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: end;

                    Text {
                        text: "Bookmarks";
                        font-size: 12pt;
                        font-weight: 600;
                        color: Theme.current.accent;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { root.bookmarks-requested(); }
                        }
                    }

                    Text {
                        text: "Notes";
                        font-size: 12pt;
                        font-weight: 600;
                        color: Theme.current.accent;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { root.notes-requested(); }
                        }
                    }
                }
            }
        }

        // Narration bar (always visible while narrating, spec §6).
        if root.narration-active : Rectangle {
            height: 52px;
            background: Theme.current.surface;
            border-radius: 0px;
            border-width: 0px;
            border-color: Theme.current.surface_variant;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: "⏮";
                    font-size: 18pt;
                    color: Theme.current.foreground;
                    vertical-alignment: center;

                    TouchArea {
                        clicked => { root.narration-skip-back(); }
                    }
                }

                Text {
                    text: root.narration-paused ? "▶" : "⏸";
                    font-size: 22pt;
                    color: Theme.current.accent;
                    vertical-alignment: center;

                    TouchArea {
                        clicked => { root.narration-play-pause(); }
                    }
                }

                Text {
                    text: "⏹";
                    font-size: 18pt;
                    color: Theme.current.error;
                    vertical-alignment: center;

                    TouchArea {
                        clicked => { root.narration-stop(); }
                    }
                }

                Text {
                    text: "⏭";
                    font-size: 18pt;
                    color: Theme.current.foreground;
                    vertical-alignment: center;

                    TouchArea {
                        clicked => { root.narration-skip-forward(); }
                    }
                }

                Text {
                    text: root.narration-speed-text;
                    font-size: 12pt;
                    font-weight: 600;
                    color: Theme.current.accent;
                    vertical-alignment: center;

                    TouchArea {
                        clicked => { root.narration-speed-cycle(); }
                    }
                }
            }
        }
    }

    // Highlight edit popover (top-right of the page area).
    if root.edit-popover-visible : Rectangle {
        x: parent.width - 220px;
        y: 8px;
        width: 200px;
        height: 116px;
        background: Theme.current.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.current.surface_variant;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: "Highlight";
                font-size: 12pt;
                font-weight: 600;
                color: Theme.current.foreground;
            }

            HorizontalLayout {
                spacing: 10px;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.current.highlight-yellow;
                    TouchArea {
                        clicked => { root.edit-color(0); }
                    }
                }
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.current.highlight-green;
                    TouchArea {
                        clicked => { root.edit-color(1); }
                    }
                }
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.current.highlight-blue;
                    TouchArea {
                        clicked => { root.edit-color(2); }
                    }
                }
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.current.highlight-pink;
                    TouchArea {
                        clicked => { root.edit-color(3); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: "Add note";
                    font-size: 11pt;
                    color: Theme.current.accent;
                    TouchArea {
                        clicked => { root.note-requested(); }
                    }
                }

                Text {
                    text: "Delete";
                    font-size: 11pt;
                    color: Theme.current.error;
                    TouchArea {
                        clicked => { root.delete-highlight(); }
                    }
                }

                Text {
                    text: "Cancel";
                    font-size: 11pt;
                    color: Theme.current.foreground;
                    opacity: 0.7;
                    TouchArea {
                        clicked => { root.close-popover(); }
                    }
                }
            }
        }
    }

    // Outline panel (M6.5): flattened PDF bookmarks, tap to jump.
    if root.pdf-mode && root.outline-open && root.chrome-visible : Rectangle {
        x: root.width - min(320px, root.width * 0.85);
        y: 0px;
        width: min(320px, root.width * 0.85);
        height: root.height;
        background: Theme.current.surface;
        border-width: 1px;
        border-color: Theme.current.surface_variant;

        // Tap anywhere outside an item closes the panel.
        TouchArea {
            clicked => { root.outline-open = false; }
        }

        Text {
            x: 12px;
            y: 8px;
            text: "Outline";
            font-size: 14pt;
            font-weight: 600;
            color: Theme.current.foreground;
        }

        if root.pdf-outline.length == 0 : Text {
            x: 12px;
            y: 40px;
            text: "No outline in this document";
            font-size: 11pt;
            color: Theme.current.foreground;
            opacity: 0.7;
        }

            outline-list := ScrollView {
                x: 0px;
                y: 44px;
                width: parent.width;
                height: parent.height - 44px;

                VerticalLayout {
                    spacing: 2px;

                    for item in root.pdf-outline : Rectangle {
                        width: outline-list.visible-width;
                        height: 36px;

                        Rectangle {
                            x: item.depth * 14px;
                            width: outline-list.visible-width - item.depth * 14px;
                            height: parent.height;

                            Text {
                                text: item.title;
                                font-size: 11pt;
                                color: Theme.current.foreground;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.outline-open = false;
                                    root.pdf-outline-jumped(item.page);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
