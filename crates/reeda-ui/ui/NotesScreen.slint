// NotesScreen.slint — per-book highlights & notes list.
// See docs/HIGHLIGHTS_SPEC.md §4.

import { Theme } from "./Theme.slint";

export struct NotesEntry {
    annotation-id: string,
    is-highlight: bool,
    color-index: int,
    snippet: string,
    note-text: string,
    chapter-title: string,
    created-at: string,
}

export component NotesScreen inherits Rectangle {
    callback back-pressed();
    callback jump-to(string);
    callback export();

    in property < string > book-title: "";
    in property < [NotesEntry] > entries: [];

    background: Theme.current.background;

    VerticalLayout {
        // Top bar
        Rectangle {
            height: 56px;
            background: Theme.current.surface;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 16px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;

                    Text {
                        text: "<";
                        font-size: 20pt;
                        color: Theme.current.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.back-pressed(); }
                    }
                }

                Text {
                    text: root.book-title;
                    font-size: 16pt;
                    font-weight: 600;
                    color: Theme.current.foreground;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 56px;
                    height: 40px;

                    Text {
                        text: "Export";
                        font-size: 12pt;
                        font-weight: 600;
                        color: Theme.current.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.export(); }
                    }
                }
            }
        }

        // Empty state
        if root.entries.length == 0 : VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 12px;

            Text {
                text: "No highlights or notes yet";
                font-size: 16pt;
                font-weight: 600;
                color: Theme.current.foreground;
                horizontal-alignment: center;
            }

            Text {
                text: "Select text in the reader and choose Highlight.";
                font-size: 13pt;
                color: Theme.current.foreground;
                opacity: 0.6;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // List
        if root.entries.length > 0 : Flickable {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                for entry in root.entries : Rectangle {
                    background: Theme.current.surface;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.current.surface_variant;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: entry.color-index == 0 ? Theme.current.highlight-yellow
                                    : entry.color-index == 1 ? Theme.current.highlight-green
                                    : entry.color-index == 2 ? Theme.current.highlight-blue
                                    : Theme.current.highlight-pink;
                            }

                            Text {
                                text: entry.chapter-title != "" ? entry.chapter-title : "Book";
                                font-size: 11pt;
                                font-weight: 600;
                                color: Theme.current.foreground;
                                opacity: 0.7;
                                vertical-alignment: center;
                            }
                        }

                        if entry.snippet != "" : Text {
                            text: "“" + entry.snippet + "”";
                            font-size: 13pt;
                            color: Theme.current.foreground;
                            wrap: word-wrap;
                        }

                        if entry.note-text != "" : Text {
                            text: entry.note-text;
                            font-size: 12pt;
                            color: Theme.current.foreground;
                            opacity: 0.85;
                            wrap: word-wrap;
                        }
                    }

                    TouchArea {
                        clicked => { root.jump-to(entry.annotation-id); }
                    }
                }
            }
        }

        // Bottom bar
        Rectangle {
            height: 48px;
            background: Theme.current.surface;
        }
    }
}